# === Database (Neon PostgreSQL Free Tier - 100% Free, No Credit Card) ===
# Pooled connection string (with ?sslmode=require&pgbouncer=true or -pooler host)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct non-pooled connection string for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# === GitHub Integration (Target: ArdanR3) ===
GITHUB_USERNAME="ArdanR3"
# Personal Access Token (Classic: repo + read:user, or Fine-grained)
GITHUB_TOKEN=""

# === AI Engine (Pilih salah satu: Groq Free Tier ATAU Google Gemini Free Tier) ===
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# === Notifications (100% Free: Telegram Bot API atau Discord Webhook) ===
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK_URL=""

# === Security & Dashboard Auth (100% Free, tanpa layanan Auth berbayar) ===
# PIN / Password untuk login dashboard web
DASHBOARD_PASSWORD=""
# Secret untuk endpoint /api/cron/* (dipakai juga di GitHub Actions Secrets)
CRON_SECRET=""

# === App & Timezone ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TZ="Asia/Jakarta"
